# ─────────────────────────────────────────────────────────────────────────────
# GoStation — variables d'environnement (racine : infra Docker + Backend Go)
# Copier en .env via `make env` (génère des secrets aléatoires). Ne jamais committer .env.
# Mobile/.env (EXPO_PUBLIC_*) et Web/.env (VITE_*) sont séparés : aucune valeur
# secrète n'y est autorisée, elles finissent dans le bundle client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker / ports exposés sur l'hôte ────────────────────────────────────────
# 127.0.0.1 = services joignables uniquement depuis la machine locale.
BIND_ADDR=127.0.0.1

# ── PostgreSQL + PostGIS ─────────────────────────────────────────────────────
POSTGIS_IMAGE=postgis/postgis:18-3.6
POSTGRES_DB=gostation
POSTGRES_USER=gostation
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5440

# ── Redis (cache H3, refresh tokens, files asynq) ────────────────────────────
REDIS_IMAGE=redis:8.10.2-alpine
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6390
REDIS_MAXMEMORY=256mb

# ── OSRM (routage voiture, algorithme MLD) ───────────────────────────────────
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.10.0-debian
OSRM_DATASET=benin
OSRM_PBF_URL=https://download.geofabrik.de/africa/benin-latest.osm.pbf
OSRM_PORT=5000
OSRM_MAX_TABLE_SIZE=100

# ── Backend Go — API (lues par Backend/internal/config) ──────────────────────
# development | staging | production
APP_ENV=development
# Fuseau des horaires d'ouverture et des rappels (UTC+1, sans heure d'été)
APP_TIMEZONE=Africa/Porto-Novo
HTTP_ADDR=:8080
# Port hôte de l'API lancée dans Docker (make api-up)
API_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
# Doit rester inférieur à HTTP_WRITE_TIMEOUT
HTTP_REQUEST_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576
# Proxys dont on accepte X-Forwarded-For (IP ou CIDR, séparés par des virgules). Vide = aucun.
HTTP_TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# debug | info | warn | error — format : json (défaut) | text
LOG_LEVEL=debug
LOG_FORMAT=json

# Garder synchronisé avec POSTGRES_* / REDIS_* ci-dessus (make env s'en charge).
DATABASE_URL=postgres://gostation:change-me-postgres@localhost:5440/gostation?sslmode=disable
DATABASE_MAX_CONNS=20
REDIS_URL=redis://:change-me-redis@localhost:6390/0
OSRM_URL=http://localhost:5000
OSRM_TIMEOUT=800ms

# Rate limit global de /api/v1, par IP (fenêtre glissante Redis)
RATE_LIMIT_IP_REQUESTS=300
RATE_LIMIT_IP_WINDOW=1m

# ── Étapes suivantes (pas encore lues par l'API) ─────────────────────────────
# Auth (étape 3) — access JWT HS256 (≥ 32 octets, hex) ; refresh tokens opaques rotatifs dans Redis.
JWT_ACCESS_SECRET=change-me-jwt-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=gostation-api

# Chiffrement des justificatifs IFU — clé maître AES-256 (32 octets, hex = 64 caractères).
DOCUMENTS_ENCRYPTION_KEY=change-me-documents-key
DOCUMENTS_STORAGE_DIR=./var/documents

# Recherche (étape 4) — fraîcheur : stale au-delà de 8 h, exclu au-delà de 24 h.
SEARCH_CACHE_TTL=60s
SEARCH_MIN_RESULTS=3
SEARCH_MAX_CANDIDATES=20
STOCK_STALE_AFTER=8h
STOCK_EXPIRED_AFTER=24h

# Rappels de mise à jour des stocks (gérants)
STOCK_REMINDER_INTERVAL=4h

# Notifications push (Expo Push API) — facultatif en dev.
EXPO_ACCESS_TOKEN=
