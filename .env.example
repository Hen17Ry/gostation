# ─────────────────────────────────────────────────────────────────────────────
# GoStation — variables d'environnement (racine : infra Docker + Backend Go)
# Copier en .env via `make env` (génère des secrets aléatoires). Ne jamais committer .env.
# Mobile/.env (EXPO_PUBLIC_*) et Web/.env (VITE_*) sont séparés : aucune valeur
# secrète n'y est autorisée, elles finissent dans le bundle client.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker / ports exposés sur l'hôte ────────────────────────────────────────
# 127.0.0.1 = services joignables uniquement depuis la machine locale.
BIND_ADDR=127.0.0.1

# ── PostgreSQL + PostGIS ─────────────────────────────────────────────────────
POSTGIS_IMAGE=postgis/postgis:18-3.6
POSTGRES_DB=gostation
POSTGRES_USER=gostation
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5440

# ── Redis (cache H3, refresh tokens, files asynq) ────────────────────────────
REDIS_IMAGE=redis:8.10.2-alpine
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6390
REDIS_MAXMEMORY=256mb

# ── OSRM (routage voiture, algorithme MLD) ───────────────────────────────────
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.10.0-debian
OSRM_DATASET=benin
OSRM_PBF_URL=https://download.geofabrik.de/africa/benin-latest.osm.pbf
OSRM_PORT=5000
OSRM_MAX_TABLE_SIZE=100

# ── Backend Go — API (lues par Backend/internal/config) ──────────────────────
# development | staging | production
APP_ENV=development
# Fuseau des horaires d'ouverture et des rappels (UTC+1, sans heure d'été)
APP_TIMEZONE=Africa/Porto-Novo
HTTP_ADDR=:8080
# Port hôte de l'API lancée dans Docker (make api-up)
API_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
# Doit rester inférieur à HTTP_WRITE_TIMEOUT
HTTP_REQUEST_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576
# Proxys dont on accepte X-Forwarded-For (IP ou CIDR, séparés par des virgules). Vide = aucun.
HTTP_TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# debug | info | warn | error — format : json (défaut) | text
LOG_LEVEL=debug
LOG_FORMAT=json

# Garder synchronisé avec POSTGRES_* / REDIS_* ci-dessus (make env s'en charge).
DATABASE_URL=postgres://gostation:change-me-postgres@localhost:5440/gostation?sslmode=disable
DATABASE_MAX_CONNS=20
REDIS_URL=redis://:change-me-redis@localhost:6390/0
OSRM_URL=http://localhost:5000
OSRM_TIMEOUT=800ms

# Rate limit global de /api/v1, par IP (fenêtre glissante Redis). Élevé : beaucoup d'abonnés
# mobiles partagent la même IP (CGNAT) ; les quotas fins sont par route (recherche, login…).
RATE_LIMIT_IP_REQUESTS=1200
RATE_LIMIT_IP_WINDOW=1m
# Clé HMAC (hex, 32 octets) des empreintes d'IP, de compte et d'installation des limiteurs :
# l'IP n'est jamais écrite en clair dans Redis, ni retrouvable sans la clé. Distincte
# d'APP_SECRET ; rotation : la remplacer et redémarrer l'API (les compteurs, d'une heure au
# plus, repartent de zéro).
RATE_LIMIT_KEY=change-me-rate-limit-key

# Auth — access JWT EdDSA (Ed25519) : « kid:graine_hex[,kid:graine_hex] ». La première clé signe,
# toutes vérifient (rotation : ajouter la nouvelle en tête, retirer l'ancienne après 15 min).
JWT_SIGNING_KEYS=change-me-jwt-signing-keys
JWT_ISSUER=gostation-api
JWT_AUDIENCE=gostation
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
ADMIN_REFRESH_TTL=12h
# Secret maître (hex, 32 octets) : sous-clés HKDF pour le HMAC des codes, le CSRF, les secrets TOTP.
APP_SECRET=change-me-app-secret
# Version courante de la politique de confidentialité (D9).
PRIVACY_POLICY_VERSION=1.0
# Cookies de session de l'admin web : Secure obligatoire en production.
COOKIE_SECURE=true

# Justificatifs IFU — clé maître AES-256 (32 octets, hex = 64 caractères), envelope encryption.
DOCUMENTS_ENCRYPTION_KEY=change-me-documents-key
DOCUMENTS_STORAGE_DIR=./var/documents
DOCUMENTS_MAX_BYTES=5242880

# Emails — SMTP générique. En dev : Mailpit (make up), interface sur http://127.0.0.1:8025.
# SMTP_TLS : none | starttls | tls (starttls ou tls obligatoire en production).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="GoStation <no-reply@gostation.local>"
SMTP_TLS=none
MAILPIT_IMAGE=axllent/mailpit:v1.31.6
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Stocks — plafonds de saisie (D16) et fraîcheur : stale au-delà de 8 h, exclu de la
# recherche au-delà de 24 h (calculée sur le plus récent de updated_at et last_confirmed_at).
STOCK_MAX_CYLINDERS=10000
STOCK_MAX_LITERS=200000
STOCK_STALE_AFTER=8h
STOCK_EXPIRED_AFTER=24h

# Recherche (D20-D23) : cache des candidats par cellule H3 res 8, quotas, stats anonymes.
SEARCH_CACHE_TTL=60s
SEARCH_MIN_RESULTS=3
SEARCH_MAX_CANDIDATES=20
SEARCH_RATE_LIMIT_IP=300
SEARCH_RATE_LIMIT_CLIENT=30
# Vidage des compteurs Redis de stats vers search_stats (tâche périodique du worker)
STATS_FLUSH_INTERVAL=5m

# ── Worker asynq (cmd/worker : emails, push, alertes, rappels, stats, purges) ──
# Une seule instance : le scheduler des tâches périodiques tourne dans le même processus.
WORKER_CONCURRENCY=10
# Inférieur au stop_grace_period du service worker (30 s dans docker-compose.yml)
WORKER_SHUTDOWN_TIMEOUT=25s
# Retries avec backoff exponentiel : base × 2^n (± 25 %), plafonné à la valeur max
JOBS_RETRY_BASE_DELAY=10s
JOBS_RETRY_MAX_DELAY=1h
# Sondes /healthz et /readyz du worker (healthcheck Docker)
WORKER_HEALTH_ADDR=:8081
# Supervision des files asynq (profil dev, make up) : http://127.0.0.1:8090
ASYNQMON_IMAGE=hibiken/asynqmon:0.7.2
ASYNQMON_PORT=8090

# Notifications push (Expo Push API). Facultatif : vide, les push sont seulement journalisés
# (type de notification, sans aucune donnée personnelle). Secret : jamais dans un bundle client.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host
EXPO_PUSH_TIMEOUT=15s
# Lecture des reçus Expo après l'envoi (DeviceNotRegistered → token supprimé)
PUSH_RECEIPTS_DELAY=15m

# Rappels de mise à jour des stocks (gérants) : délai depuis la dernière mise à jour ou
# confirmation, et entre deux rappels (4 par jour au plus, arrêt après 3 rappels ignorés).
STOCK_REMINDER_INTERVAL=4h

# Durées de conservation (ARCHITECTURE §8, docs/legal/inventaire-donnees.md), appliquées par les
# purges quotidiennes du worker (une tâche par règle, `make purge-dry-run` pour simuler). Valeurs
# provisoires, À VALIDER PAR UN JURISTE ; format Go, 24 h au moins (30 jours = 720h, 12 mois = 8760h).
# Boîte de réception, journal des alertes « de retour en stock », tokens push sans réenregistrement.
RETENTION_NOTIFICATIONS=720h
RETENTION_BACK_IN_STOCK_ALERTS=720h
RETENTION_DEVICE_TOKENS=2160h
# Compte sans activité (connexion ou renouvellement de session) : supprimé (anonymisé) au bout de
# 24 mois, après un email d'avertissement 30 jours avant.
RETENTION_INACTIVE_ACCOUNTS=17520h
RETENTION_INACTIVITY_WARNING=720h
# Signalements : auteur pseudonymisé après 90 jours, signalement supprimé après 12 mois.
RETENTION_REPORT_AUTHORS=2160h
RETENTION_REPORTS=8760h
# Journal d'audit : 12 mois.
RETENTION_AUDIT_LOGS=8760h
# Justificatifs IFU : 6 mois après un refus sans renvoi, 12 mois après la suppression du compte du
# gérant (celui d'une station active est conservé).
RETENTION_REJECTED_DOCUMENTS=4368h
RETENTION_DELETED_STATION_DOCUMENTS=8760h
# Historique des stocks : 12 mois, puis agrégé par jour sans lien avec le gérant.
RETENTION_STOCK_HISTORY=8760h
# Demandes d'exercice des droits closes (preuve) : 3 ans ; alertes admin résolues et métadonnées
# des exports admin : 12 mois.
RETENTION_DATA_REQUESTS=26280h
RETENTION_ADMIN_ALERTS=8760h
RETENTION_EXPORT_RECORDS=8760h
# Demandes de déplacement d'épingle (distances, auteur, motif de l'admin) : 12 mois après la
# décision ; celles en attente restent.
RETENTION_LOCATION_REQUESTS=8760h

# Suivi des plantages (GlitchTip auto-hébergé, compatible Sentry, D90) : erreurs 5xx, panics et
# tâches en échec définitif, sans donnée personnelle (requête, IP, utilisateur retirés ; emails,
# jetons, coordonnées masqués). Vide : désactivé. Environnement : APP_ENV par défaut.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Demandes d'exercice des droits : délai de réponse (30 jours, provisoire), alerte de l'admin à
# l'approche de l'échéance, adresse de contact affichée dans les emails (vide : la personne répond
# à l'équipe par le moyen par lequel elle a fait sa demande).
PRIVACY_REQUEST_DEADLINE=720h
PRIVACY_REQUEST_DUE_SOON=168h
PRIVACY_CONTACT_EMAIL=
