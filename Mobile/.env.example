# Variables publiques de l'app (EXPO_PUBLIC_* : incluses dans le bundle, jamais de secret).
# Dev sur téléphone Android : adb reverse tcp:8080 tcp:8080, l'API de l'hôte est alors vue en 127.0.0.1.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
# Adresse de contact affichée à un gérant suspendu (bouton « Écrire à l'équipe ») ; vide : il est
# invité à répondre à l'email de suspension.
EXPO_PUBLIC_SUPPORT_EMAIL=
# Suivi des plantages (GlitchTip auto-hébergé, D90) : DSN public du projet « mobile ». Vide :
# désactivé. Builds EAS : variable d'environnement EAS (comme EXPO_PUBLIC_API_URL).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Environnement du serveur visé : « staging » affiche le bandeau Staging et le plantage de test
# (Compte). Builds EAS : variable EAS de l'environnement preview ; vide en production.
EXPO_PUBLIC_APP_ENV=
