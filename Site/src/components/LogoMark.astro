---
/** Marque GoStation : épingle de station + éclair (disponible tout de suite), sur pastille orange. */
type Props = { class?: string }
const { class: className } = Astro.props
---

<svg viewBox="0 0 32 32" class:list={['logo-mark', className]} aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" class="logo-bg"></rect>
  <path
    d="M16 6.5c-4 0-7.2 3.1-7.2 7 0 5.1 6.1 10.9 6.6 11.4a.9.9 0 0 0 1.2 0c.5-.5 6.6-6.3 6.6-11.4 0-3.9-3.2-7-7.2-7Z"
    class="logo-pin"
  ></path>
  <path d="M16.9 9.6l-3.2 4.6h2.4l-.9 3.9 3.3-4.9h-2.5l.9-3.6Z" class="logo-bg"></path>
</svg>

<style>
  .logo-mark {
    width: 2rem;
    height: 2rem;
    flex: none;
  }
  .logo-bg {
    fill: var(--primary);
  }
  .logo-pin {
    fill: var(--primary-foreground);
  }
</style>
