  ],
  ban: ['M4.93 4.93l14.14 14.14', 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z'],
  plus: ['M5 12h14', 'M12 5v14'],
  store: [
    'M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5',
    'M17.77 10.88a2.4 2.4 0 0 1-3.77 0 2.4 2.4 0 0 1-3.77 0 2.4 2.4 0 0 1-3.77 0 2.7 2.7 0 0 1-4.46-2.92l2.79-4.36A2 2 0 0 1 5.7 3h12.6a2 2 0 0 1 1.66.89l2.79 4.36a2.7 2.7 0 0 1-4.46 2.92Z',
