    'M16 8 2 22',
    'M17.5 15H9',
  ],
} as const

type Props = { name: keyof typeof paths; class?: string }
const { name, class: className } = Astro.props
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paths[name].map((d) => (
    <path d={d} />
  ))}
</svg>

<style>
  .icon {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }
</style>
