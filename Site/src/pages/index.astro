---
import Companies from '@/components/scenes/Companies.astro'
import Final from '@/components/scenes/Final.astro'
import Managers from '@/components/scenes/Managers.astro'
import Opening from '@/components/scenes/Opening.astro'
import Problem from '@/components/scenes/Problem.astro'
import Questions from '@/components/scenes/Questions.astro'
import Route from '@/components/scenes/Route.astro'
import Solution from '@/components/scenes/Solution.astro'
import Base from '@/layouts/Base.astro'
---

<Base
  title="GoStation · Le gaz, l'essence, le gasoil. Là où il y en a."
  description="Gaz (5, 10 et 25 kg), essence, gasoil : GoStation trouve la station la plus proche qui a votre produit en stock au Bénin, puis vous y guide. Gratuit, sur Android."
>
  {/* Scènes épinglées : chacune dans son enveloppe, que ScrollTrigger emploie comme pin-spacer
       (lib/motion/scenes/common.ts). L'épinglage et ses rafraîchissements ne déplacent alors pas
       la scène dans le DOM (le premier rendu du titre reste compté, aucun sous-arbre recréé), et
       l'enveloppe réserve en CSS la longueur d'épinglage de sa scène (global.css) : la page a sa
       hauteur finale avant toute animation, que la scène soit créée ou non
       (lib/motion/lazy-scenes.ts). Sans animation, l'enveloppe est neutre. */}
  <div data-pin="opening">
    <Opening />
  </div>
  <div data-pin="problem">
    <Problem />
  </div>
  <div data-pin="solution">
    <Solution />
  </div>
  <div data-pin="route">
    <Route />
  </div>
  <div data-pin="managers">
    <Managers />
  </div>
  <Companies />
  <div data-pin="final">
    <Final />
  </div>
  <Questions />
</Base>
