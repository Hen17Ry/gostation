# Site public (Astro) : variables PUBLIC_* seulement, figées dans le build, rien de secret.
# Adresse canonique du site (sitemap, Open Graph, données structurées).
PUBLIC_SITE_URL=https://gostation.bj
# Téléchargement de l'app : APK du build preview en staging, Google Play plus tard.
PUBLIC_APK_URL=
# staging : balise noindex (Caddy envoie aussi X-Robots-Tag) ; production : indexable.
PUBLIC_APP_ENV=development
