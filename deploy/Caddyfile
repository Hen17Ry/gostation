# GoStation — reverse proxy de production (docker-compose.prod.yml, docs/DEPLOY.md).
# TLS automatique (Let's Encrypt) pour chaque site ; DOMAIN, ACME_EMAIL, APP_ENV et
# PUBLIC_EXTRA_HOSTS viennent de .env.production. L'API, l'admin et GlitchTip ne sont jamais
# indexés ; le site public ne l'est qu'en production (APP_ENV, ci-dessous). Aucun journal d'accès (pas de directive log dans les sites) et un journal
# d'erreurs expurgé (ci-dessous) : ni IP ni URL chez le proxy ; le journal d'accès de l'API masque
# déjà les paramètres (règles 2 et 10). Les en-têtes de l'admin doivent rester identiques à ADMIN_HEADERS
# (Web/build/csp.ts) : un test les compare.
{
	email {$ACME_EMAIL}
	# Pas d'API d'administration de Caddy : la configuration ne change qu'au redéploiement.
	admin off
	# Journaux de Caddy (erreurs du proxy comprises, logger http.log.error) : jamais l'IP, le port,
	# les en-têtes ni l'URL du client (sa query string peut porter lat/lng), règles 2 et 10.
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
				request>tls delete
			}
		}
	}
}

# API : l'API pose elle-même ses en-têtes de sécurité (middleware.SecurityHeaders). Caddy remplace
# tout X-Forwarded-For venu du client par l'IP de connexion ; l'API ne le lit que depuis le réseau
# du proxy (HTTP_TRUSTED_PROXIES).
api.{$DOMAIN} {
	request_body {
		max_size 6MB
	}
	header X-Robots-Tag "noindex, nofollow"
	# Pas de sonde active : /readyz échoue quand OSRM est en panne, alors que l'API se replie
	# sur le vol d'oiseau. Le healthcheck Docker redémarre l'API si besoin.
	reverse_proxy api:8080
	header -Server
}

# Admin web : build statique de Web/ (dist/), application monopage.
admin.{$DOMAIN} {
	root * /srv/admin
	encode zstd gzip
	header {
		Content-Security-Policy "{file./srv/admin/csp.txt}"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	# Fichiers du build nommés par empreinte : cache d'un an ; le reste (index.html) revalidé.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@spa not path /assets/*
	header @spa Cache-Control "no-cache"
	try_files {path} /index.html
	file_server {
		hide csp.txt
	}
}

# Site public (Site/, Astro statique) : l'histoire de GoStation, et les textes légaux aux adresses
# exigées par Google OAuth et Google Play (/politique-confidentialite, /cgu, /suppression-compte ;
# sans extension grâce à try_files). PUBLIC_EXTRA_HOSTS (www.<domaine>…) : servis aussi, et
# redirigés vers le domaine principal. CSP sans unsafe-inline, générée au build
# (Site/build/csp.mts → csp.txt) ; les autres en-têtes doivent rester identiques à SITE_HEADERS
# (un test les compare).
{$DOMAIN} {$PUBLIC_EXTRA_HOSTS} {
	@extra not host {$DOMAIN}
	redir @extra https://{$DOMAIN}{uri} permanent
	# Indexation en production seulement : un staging ne doit jamais apparaître dans un moteur.
	map {env.APP_ENV} {robots_tag} {robots_disallow} {
		production all ""
		default "noindex, nofollow" /
	}
	header X-Robots-Tag {robots_tag}
	respond /robots.txt "User-agent: *
Disallow: {robots_disallow}
Sitemap: https://{$DOMAIN}/sitemap-index.xml
"
	root * /srv/public
	encode zstd gzip
	header {
		Content-Security-Policy "{file./srv/public/csp.txt}"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	# Fichiers du build nommés par empreinte : cache d'un an ; pages, cartes et images : 10 min.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path /assets/*
	header @other Cache-Control "public, max-age=600"
	try_files {path} {path}.html
	file_server {
		hide csp.txt
	}
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

# GlitchTip (D90) : reçoit les rapports de plantage des SDK (API, worker, admin, app) et sert son
# interface. L'adresse IP du client ne lui parvient jamais : X-Forwarded-For et X-Real-IP sont
# retirés, GlitchTip ne voit que l'adresse du proxy.
errors.{$DOMAIN} {
	request_body {
		max_size 20MB
	}
	reverse_proxy glitchtip:8000 {
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
