# ─────────────────────────────────────────────────────────────────────────────
# GoStation — production / staging (docker-compose.prod.yml). Runbook : docs/DEPLOY.md.
#
#   scripts/gen-prod-secrets.sh        crée .env.production depuis ce modèle (secrets aléatoires,
#                                      droits 600 ; refuse d'écraser un fichier existant)
#   puis remplacer chaque « fill-me » : scripts/prod.sh check refuse d'aller plus loin sinon.
#
# Jamais commité (.gitignore). Les adresses internes (DATABASE_URL, REDIS_URL, OSRM_URL, proxys
# de confiance, CORS) sont fixées par docker-compose.prod.yml. Source de vérité des variables du
# backend : .env.example (mêmes noms, mêmes formats).
# ─────────────────────────────────────────────────────────────────────────────

# ── Serveur et domaine ───────────────────────────────────────────────────────
# Domaine principal : api.<DOMAIN>, admin.<DOMAIN>, errors.<DOMAIN>, site public sur <DOMAIN>.
DOMAIN=fill-me-domain
# Adresse de contact Let's Encrypt (expiration, incidents de certificat).
ACME_EMAIL=fill-me-acme-email
# production | staging (journaux et GlitchTip distinguent les deux).
APP_ENV=production
SENTRY_ENVIRONMENT=production

# ── PostgreSQL + PostGIS (jamais exposé) ─────────────────────────────────────
POSTGIS_IMAGE=postgis/postgis:18-3.6
POSTGRES_DB=gostation
POSTGRES_USER=gostation
POSTGRES_PASSWORD=change-me-postgres
DATABASE_MAX_CONNS=20

# ── Redis (jamais exposé ; persistance AOF) ──────────────────────────────────
REDIS_IMAGE=redis:8.10.2-alpine
REDIS_PASSWORD=change-me-redis
REDIS_MAXMEMORY=256mb

# ── OSRM (routage, jamais exposé) ────────────────────────────────────────────
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.10.0-debian
OSRM_DATASET=benin
OSRM_PBF_URL=https://download.geofabrik.de/africa/benin-latest.osm.pbf
OSRM_MAX_TABLE_SIZE=100
OSRM_TIMEOUT=800ms

# ── API et worker ────────────────────────────────────────────────────────────
APP_TIMEZONE=Africa/Porto-Novo
LOG_LEVEL=info
LOG_FORMAT=json
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_REQUEST_TIMEOUT=20s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576
RATE_LIMIT_IP_REQUESTS=1200
RATE_LIMIT_IP_WINDOW=1m
RATE_LIMIT_KEY=change-me-rate-limit-key

JWT_SIGNING_KEYS=change-me-jwt-signing-keys
JWT_ISSUER=gostation-api
JWT_AUDIENCE=gostation
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
ADMIN_REFRESH_TTL=12h
APP_SECRET=change-me-app-secret
PRIVACY_POLICY_VERSION=1.0
COOKIE_SECURE=true

# Justificatifs, exports, copies « Mes données » : chiffrés par l'application, puis stockés sur un
# stockage objet compatible S3 (bucket privé, créé à l'avance, sans accès public). Une clé dédiée
# à ce bucket, distincte de celle des sauvegardes.
DOCUMENTS_ENCRYPTION_KEY=change-me-documents-key
DOCUMENTS_MAX_BYTES=5242880
STORAGE_DRIVER=s3
S3_ENDPOINT=fill-me-s3-endpoint
S3_REGION=fill-me-s3-region
S3_BUCKET=fill-me-s3-bucket
S3_ACCESS_KEY_ID=fill-me-s3-access-key
S3_SECRET_ACCESS_KEY=fill-me-s3-secret-key
S3_TLS=true
S3_PATH_STYLE=false
S3_PREFIX=production

# Emails (SMTP réel, TLS obligatoire). Domaine d'envoi avec SPF, DKIM et DMARC (docs/DEPLOY.md).
SMTP_HOST=fill-me-smtp-host
SMTP_PORT=587
SMTP_USERNAME=fill-me-smtp-username
SMTP_PASSWORD=fill-me-smtp-password
SMTP_FROM="GoStation <no-reply@fill-me-domain>"
SMTP_TLS=starttls

STOCK_MAX_CYLINDERS=10000
STOCK_MAX_LITERS=200000
STOCK_STALE_AFTER=8h
STOCK_EXPIRED_AFTER=24h
SEARCH_CACHE_TTL=60s
SEARCH_MIN_RESULTS=3
SEARCH_MAX_CANDIDATES=20
SEARCH_RATE_LIMIT_IP=300
SEARCH_RATE_LIMIT_CLIENT=30
STATS_FLUSH_INTERVAL=5m

WORKER_CONCURRENCY=10
WORKER_SHUTDOWN_TIMEOUT=25s
JOBS_RETRY_BASE_DELAY=10s
JOBS_RETRY_MAX_DELAY=1h

# Push : token d'accès Expo (sécurité renforcée des push activée sur le projet EAS).
EXPO_ACCESS_TOKEN=fill-me-expo-access-token
EXPO_PUSH_URL=https://exp.host
EXPO_PUSH_TIMEOUT=15s
PUSH_RECEIPTS_DELAY=15m
STOCK_REMINDER_INTERVAL=4h

# Conservation (valeurs provisoires, à valider par le juriste : D69).
RETENTION_NOTIFICATIONS=720h
RETENTION_BACK_IN_STOCK_ALERTS=720h
RETENTION_DEVICE_TOKENS=2160h
RETENTION_INACTIVE_ACCOUNTS=17520h
RETENTION_INACTIVITY_WARNING=720h
RETENTION_REPORT_AUTHORS=2160h
RETENTION_REPORTS=8760h
RETENTION_AUDIT_LOGS=8760h
RETENTION_REJECTED_DOCUMENTS=4368h
RETENTION_DELETED_STATION_DOCUMENTS=8760h
RETENTION_STOCK_HISTORY=8760h
RETENTION_DATA_REQUESTS=26280h
RETENTION_ADMIN_ALERTS=8760h
RETENTION_EXPORT_RECORDS=8760h
RETENTION_LOCATION_REQUESTS=8760h

PRIVACY_REQUEST_DEADLINE=720h
PRIVACY_REQUEST_DUE_SOON=168h
PRIVACY_CONTACT_EMAIL=fill-me-privacy-email

# ── Suivi des plantages (GlitchTip, D90) ─────────────────────────────────────
# Vide au premier déploiement : créer les projets dans GlitchTip (docs/DEPLOY.md), puis copier
# leurs DSN ici (api/worker et admin) et dans les variables EAS (app), et redéployer.
SENTRY_DSN=
VITE_SENTRY_DSN=
GLITCHTIP_IMAGE=glitchtip/glitchtip:6.2.6
GLITCHTIP_SECRET_KEY=change-me-glitchtip-secret
GLITCHTIP_DB_PASSWORD=change-me-glitchtip-db
GLITCHTIP_FROM_EMAIL="GoStation <errors@fill-me-domain>"
# Format django-environ : smtp+tls://utilisateur:mot-de-passe@hôte:587 (caractères spéciaux encodés).
GLITCHTIP_EMAIL_URL=fill-me-glitchtip-email-url

# ── Sauvegardes (scripts/backup.sh, restic vers un stockage S3) ──────────────
# Dépôt restic chiffré (AES-256) dans un bucket dédié, idéalement chez un autre fournisseur ou
# dans une autre région que le serveur. Garder RESTIC_PASSWORD hors du serveur aussi (coffre de
# mots de passe) : sans lui, les sauvegardes sont illisibles.
RESTIC_REPOSITORY=fill-me-restic-repository
RESTIC_PASSWORD=change-me-restic
BACKUP_S3_ACCESS_KEY_ID=fill-me-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=fill-me-backup-secret-key
# Rotation : 7 quotidiennes, 4 hebdomadaires, 3 mensuelles (une donnée purgée disparaît des
# sauvegardes 3 mois au plus après).
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
