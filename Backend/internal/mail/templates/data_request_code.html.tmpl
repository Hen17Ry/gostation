{{define "content"}}
<p class="text" style="margin:0 0 16px;font-size:16px;line-height:24px;color:#0F172A;">Bonjour {{.FirstName}},</p>
<p class="text" style="margin:0 0 20px;font-size:16px;line-height:24px;color:#0F172A;">{{.Lead}}</p>
{{template "codebox" .}}
<p class="muted" style="margin:0 0 12px;font-size:14px;line-height:22px;color:#475569;">{{.Next}} Ce code est valable <strong>{{.ExpiresDays}} jours</strong>.</p>
<p class="muted" style="margin:0;font-size:14px;line-height:22px;color:#475569;">Vous n'avez fait aucune demande ? Ignorez cet email : rien ne sera traité sans ce code.</p>
{{end}}
