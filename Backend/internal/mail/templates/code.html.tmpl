{{define "codebox"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px;">
  <tr>
    <td align="center" class="codebox" style="background-color:#FFF7ED;border:2px solid #FED7AA;border-radius:12px;padding:24px 16px;">
      <span class="code" style="font-family:'SFMono-Regular',Menlo,Consolas,'Liberation Mono',monospace;font-size:36px;line-height:44px;font-weight:700;letter-spacing:10px;color:#431407;">{{.Code}}</span>
    </td>
  </tr>
</table>
{{end}}
