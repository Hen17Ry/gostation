# Variables du client web (VITE_* uniquement, jamais de secret : tout finit dans le bundle).
# Copier en Web/.env si besoin de surcharger.

# Origine de l'API. Vide en dev : les appels passent par le proxy Vite (même origine, cookies
# SameSite=Strict, jeton CSRF lisible). En prod : https://api.<domaine>.
VITE_API_BASE_URL=

# Suivi des plantages (GlitchTip auto-hébergé, D90). DSN public du projet « admin » (il finit dans
# le bundle : ce n'est pas un secret). Vide : SDK jamais chargé. Son origine est ajoutée à la CSP.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# Cible du proxy de dev (vite dev et vite preview) vers l'API Go.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
